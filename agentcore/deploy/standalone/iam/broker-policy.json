{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DriveSandboxSessions",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:InvokeAgentRuntimeCommand", "bedrock-agentcore:StopRuntimeSession"],
      "Resource": [
        "arn:aws:bedrock-agentcore:{{REGION}}:{{ACCOUNT_ID}}:runtime/{{SANDBOX_RUNTIME_NAME}}-*",
        "arn:aws:bedrock-agentcore:{{REGION}}:{{ACCOUNT_ID}}:runtime/{{SANDBOX_RUNTIME_NAME}}-*/runtime-endpoint/*"
      ]
    },
    {
      "Sid": "Registry",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{TABLE_NAME}}"
    },
    {
      "Sid": "ECRImagePull",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:{{REGION}}:{{ACCOUNT_ID}}:repository/{{ECR_BROKER}}"
    },
    {
      "Sid": "ECRToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "LogGroups",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:CreateLogGroup"],
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/bedrock-agentcore/runtimes/*"
    },
    {
      "Sid": "LogResourcePolicy",
      "Effect": "Allow",
      "Action": "logs:PutResourcePolicy",
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/bedrock-agentcore/runtimes/{{BROKER_RUNTIME_NAME}}-*"
    },
    {
      "Sid": "LogDescribe",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:*"
    },
    {
      "Sid": "LogWrite",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
    },
    {
      "Sid": "XRay",
      "Effect": "Allow",
      "Action": ["xray:PutTraceSegments", "xray:PutTelemetryRecords", "xray:GetSamplingRules", "xray:GetSamplingTargets"],
      "Resource": "*"
    },
    {
      "Sid": "Metrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {"StringEquals": {"cloudwatch:namespace": "bedrock-agentcore"}}
    },
    {
      "Sid": "WorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetWorkloadAccessToken",
        "bedrock-agentcore:GetWorkloadAccessTokenForJWT"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:{{REGION}}:{{ACCOUNT_ID}}:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:{{REGION}}:{{ACCOUNT_ID}}:workload-identity-directory/default/workload-identity/{{BROKER_RUNTIME_NAME}}-*"
      ]
    }
  ]
}
